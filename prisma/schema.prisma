generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords DailyPlantRecord[]
  snapshots    ReportSnapshot[]
}

model AppUser {
  id           String   @id @default(cuid())
  username     String?  @unique
  name         String
  email        String   @unique
  role         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plantAccesses    PlantAccess[]    @relation("PlantAccessUser")
  assignedAccesses PlantAccess[]    @relation("PlantAccessAssignedBy")
  revokedAccesses  PlantAccess[]    @relation("PlantAccessRevokedBy")
  actorAuditLogs   AccessAuditLog[] @relation("AccessAuditActor")
  targetAuditLogs  AccessAuditLog[] @relation("AccessAuditTarget")

  @@index([role, isActive])
}

model PlantAccess {
  id           String    @id @default(cuid())
  userId       String
  plantCode    String
  isActive     Boolean   @default(true)
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedById  String?
  revokedAt    DateTime?

  user       AppUser  @relation("PlantAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy AppUser? @relation("PlantAccessAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy  AppUser? @relation("PlantAccessRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([plantCode, isActive])
  @@index([userId, isActive])
}

model AccessAuditLog {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String?
  targetUserId String?
  plantCode    String?
  summary      String
  createdAt    DateTime @default(now())

  actorUser  AppUser? @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser AppUser? @relation("AccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([plantCode, createdAt])
  @@index([targetUserId, createdAt])
}

model DailyPlantRecord {
  id               String    @id
  plantId          String
  plantCode        String
  recordDate       DateTime
  status           String
  reviewStatus     String
  validationStatus String
  payload          Json
  submittedAt      DateTime?
  submittedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plant     Plant      @relation(fields: [plantId], references: [id])
  auditLogs AuditLog[]

  @@unique([plantCode, recordDate])
  @@index([plantId, recordDate])
  @@index([status, validationStatus])
}

model AuditLog {
  id        String   @id @default(cuid())
  recordId  String
  action    String
  actor     String?
  summary   String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  record DailyPlantRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
}

model ReportSnapshot {
  id               String   @id
  plantId          String
  version          String   @unique
  periodStart      DateTime
  periodEnd        DateTime
  sourceFileName   String
  sourceChecksum   String
  validationStatus String
  payload          Json
  lockedAt         DateTime
  createdAt        DateTime @default(now())

  plant            Plant             @relation(fields: [plantId], references: [id])
  validationIssues ValidationIssue[]
  generatedReports GeneratedReport[]

  @@index([plantId, periodStart, periodEnd])
  @@index([sourceChecksum])
}

model ValidationIssue {
  id         String    @id @default(cuid())
  snapshotId String
  severity   String
  code       String
  message    String
  date       DateTime?
  field      String?
  createdAt  DateTime  @default(now())

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, severity])
}

model GeneratedReport {
  id          String   @id @default(cuid())
  snapshotId  String
  format      String
  storageKey  String
  checksum    String
  locked      Boolean  @default(true)
  generatedBy String?
  generatedAt DateTime @default(now())

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([snapshotId, format])
}
